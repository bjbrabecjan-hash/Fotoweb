# Server-only configuration for the contact form
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Fotoweb <poptavky@your-verified-domain.cz>
CONTACT_TO_EMAIL=fotohanabrabcova@gmail.com

# Client galleries and feedback
# Cloud: use the existing Supabase integration on Vercel.
# NEXT_PUBLIC_SUPABASE_URL can be used as the URL fallback; keys stay server-only.
PROOFING_STORAGE=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy Vercel integrations may provide SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SERVICE_ROLE_KEY=
PROOFING_ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROOFING_SESSION_SECRET=
PROOFING_DATA_DIR=.proofing-data
PROOFING_PUBLIC_URL=http://localhost:3000

# Offline development only: set PROOFING_STORAGE=disk. Never on Vercel.

# Optional mail delivery. From must belong to a verified domain in Resend.
PROOFING_EMAIL_FROM=
PROOFING_EMAIL_TO=fotohanabrabcova@gmail.com
